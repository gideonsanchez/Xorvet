rules_version = '2';

// XORVET WALLET keeps all Firestore access on the server (Next.js route handlers using the
// Firebase Admin SDK, which bypasses these rules). Browsers never read or write Firestore
// directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
